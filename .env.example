# UBUZIMA HMS - environment template (do not commit real secrets)

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=UBUZIMA HMS

# Database (PostgreSQL / Prisma)
DATABASE_URL=postgresql://ubuzima:ubuzima_dev_password_change_me@localhost:5432/ubuzima_hms?schema=public

# Cache / queues (optional in current demo mode)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MFA_ISSUER=UBUZIMA_HMS

# AI (optional; feature degrades safely when unset)
GEMINI_API_KEY=

# Rwanda integrations (AUTHORIZED ONLY - remain simulated in demo mode when unset)
NIDA_INTEGRATION_MODE=simulated
NIDA_API_URL=
NIDA_API_KEY=
RSSB_INTEGRATION_MODE=simulated
RSSB_API_URL=
RSSB_API_KEY=
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
ELMIS_API_URL=
ELMIS_API_KEY=
CIVIL_REGISTRATION_API_URL=
CIVIL_REGISTRATION_API_KEY=
FHIR_SERVER_URL=

# Payments (official provider APIs only; never store MoMo PINs)
MTN_MOMO_INTEGRATION_MODE=simulated
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=
AIRTEL_MONEY_INTEGRATION_MODE=simulated
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_BASE_URL=

# Notifications
SMS_PROVIDER=simulated
SMS_API_KEY=
EMAIL_PROVIDER=simulated
EMAIL_API_KEY=

# Security / storage
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/uploads
LOG_LEVEL=info
