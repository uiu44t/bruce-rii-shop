// UBUZIMA HMS - PostgreSQL schema (Prisma)
// Primary relational store for Phase 1+ foundation.
// Run migrations only against an authorized PostgreSQL instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  SSO
}

enum FacilityType {
  REFERRAL_HOSPITAL
  DISTRICT_HOSPITAL
  HEALTH_CENTER
  CLINIC
  PHARMACY
  LABORATORY
  BLOOD_BANK
  NATIONAL_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientStatus {
  REGISTERED
  ADMITTED
  OUTPATIENT
  DISCHARGED
  TRANSFERRED
  DECEASED
}

enum ConsentType {
  EMR_ACCESS
  DATA_SHARING
  INSURANCE_VERIFICATION
  TELEMEDICINE
  RESEARCH_AGGREGATE
  EMERGENCY_OVERRIDE
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  TELEMEDICINE
  COMMUNITY
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  RESERVED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  APPROVED
  CANCELLED
}

enum ImagingOrderStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  REPORTED
  CANCELLED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Facility {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  type            FacilityType
  province        String?
  district        String?
  sector          String?
  cell            String?
  village         String?
  address         String?
  phone           String?
  email           String?
  latitude        Decimal?        @db.Decimal(10, 7)
  longitude       Decimal?        @db.Decimal(10, 7)
  isActive        Boolean         @default(true)
  departments     Department[]
  users           User[]
  patients        Patient[]       @relation("RegisteredFacility")
  encounters      Encounter[]
  appointments    Appointment[]
  admissions      Admission[]
  wards           Ward[]
  labOrders       LaboratoryOrder[]
  imagingOrders   ImagingOrder[]
  pharmacyItems   PharmacyInventory[]
  invoices        Invoice[]
  ambulances      Ambulance[]
  referralsFrom   Referral[]      @relation("ReferralSource")
  referralsTo     Referral[]      @relation("ReferralDestination")
  auditLogs       AuditLog[]
  integrationLogs IntegrationLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([district, type])
}

model Department {
  id         String    @id @default(cuid())
  facilityId String
  name       String
  code       String?
  isActive   Boolean   @default(true)
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  users      User[]
  wards      Ward[]

  @@unique([facilityId, name])
  @@index([facilityId])
}

model User {
  id                 String         @id @default(cuid())
  facilityId         String?
  departmentId       String?
  roleId             String
  email              String         @unique
  phone              String?
  fullName           String
  status             UserStatus     @default(ACTIVE)
  authProvider       AuthProvider   @default(LOCAL)
  passwordHash       String?
  mfaEnabled         Boolean        @default(false)
  mfaSecretEncrypted String?
  lastLoginAt        DateTime?
  refreshTokenHash   String?
  facility           Facility?      @relation(fields: [facilityId], references: [id])
  department         Department?    @relation(fields: [departmentId], references: [id])
  role               Role           @relation(fields: [roleId], references: [id])
  consultations      Consultation[] @relation("ClinicianConsultations")
  createdOrders      LaboratoryOrder[] @relation("OrderedBy")
  auditLogs          AuditLog[]     @relation("ActorLogs")
  notifications      Notification[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([facilityId, roleId])
  @@index([email])
}

model Patient {
  id                   String               @id @default(cuid())
  registeredFacilityId String?
  mrn                  String               @unique
  firstName            String
  lastName             String
  fullName             String
  gender               Gender               @default(UNKNOWN)
  dateOfBirth          DateTime?
  phone                String?
  email                String?
  bloodGroup           String?
  address              String?
  province             String?
  district             String?
  sector               String?
  cell                 String?
  village              String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  photoUrl             String?
  status               PatientStatus        @default(REGISTERED)
  registeredFacility   Facility?            @relation("RegisteredFacility", fields: [registeredFacilityId], references: [id])
  identifiers          PatientIdentifier[]
  consents             PatientConsent[]
  medicalRecords       MedicalRecord[]
  encounters           Encounter[]
  allergies            Allergy[]
  vitalSigns           VitalSign[]
  appointments         Appointment[]
  admissions           Admission[]
  prescriptions        Prescription[]
  labOrders            LaboratoryOrder[]
  imagingOrders        ImagingOrder[]
  invoices             Invoice[]
  referrals            Referral[]
  maternalRecords      MaternalRecord[]
  childHealthRecords   ChildHealthRecord[]
  vaccinations         Vaccination[]
  communityVisits      CommunityHealthVisit[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([registeredFacilityId])
}

model PatientIdentifier {
  id           String   @id @default(cuid())
  patientId    String
  type         String   // NATIONAL_ID, PASSPORT, INSURANCE_MEMBER_ID, FACILITY_ID
  valueHash    String   // store hash/tokenized value where possible
  valueMasked  String
  issuer       String?
  isPrimary    Boolean  @default(false)
  verifiedAt   DateTime?
  verificationSource String? // clearly labeled adapter/source
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, valueHash])
  @@index([patientId])
}

model PatientConsent {
  id          String      @id @default(cuid())
  patientId   String
  type        ConsentType
  granted     Boolean
  purpose     String?
  channel     String?
  grantedAt   DateTime?
  expiresAt   DateTime?
  recordedBy  String?
  legalBasis  String?     @default("Rwanda Data Protection and Privacy Law - configure per deployment")
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([patientId, type])
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patientId   String
  summary     String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  diagnoses   Diagnosis[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
}

model Encounter {
  id          String        @id @default(cuid())
  patientId   String
  facilityId  String
  type        EncounterType
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  clinicianId String?
  notes       String?
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility    Facility      @relation(fields: [facilityId], references: [id])
  consultations Consultation[]

  @@index([patientId, startedAt])
  @@index([facilityId, startedAt])
}

model Consultation {
  id              String       @id @default(cuid())
  medicalRecordId String?
  encounterId     String?
  clinicianId     String?
  subjective      String?
  objective       String?
  assessment      String?
  plan            String?
  diagnosisText   String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  encounter       Encounter?   @relation(fields: [encounterId], references: [id])
  clinician       User?        @relation("ClinicianConsultations", fields: [clinicianId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([encounterId])
  @@index([clinicianId])
}

model Diagnosis {
  id              String        @id @default(cuid())
  medicalRecordId String
  code            String?
  system          String?       // ICD-10/ICD-11 when configured
  description     String
  isPrimary       Boolean       @default(false)
  diagnosedAt     DateTime      @default(now())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

model Allergy {
  id        String   @id @default(cuid())
  patientId String
  substance String
  reaction  String?
  severity  String?
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([patientId])
}

model VitalSign {
  id            String   @id @default(cuid())
  patientId     String
  recordedAt    DateTime @default(now())
  systolicBp    Int?
  diastolicBp   Int?
  heartRate     Int?
  temperatureC  Decimal? @db.Decimal(4, 1)
  spo2          Int?
  respiratoryRate Int?
  weightKg      Decimal? @db.Decimal(6, 2)
  heightCm      Decimal? @db.Decimal(6, 2)
  recordedBy    String?
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  facilityId  String
  clinicianId String?
  department  String?
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility    Facility          @relation(fields: [facilityId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([facilityId, scheduledAt])
  @@index([patientId, scheduledAt])
}

model Ward {
  id           String     @id @default(cuid())
  facilityId   String
  departmentId String?
  name         String
  type         String
  facility     Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  beds         Bed[]

  @@unique([facilityId, name])
}

model Bed {
  id         String    @id @default(cuid())
  wardId     String
  bedNumber  String
  status     BedStatus @default(AVAILABLE)
  dailyRate  Decimal?  @db.Decimal(12, 2)
  ward       Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@unique([wardId, bedNumber])
  @@index([status])
}

model Admission {
  id            String          @id @default(cuid())
  patientId     String
  facilityId    String
  bedId         String?
  admittedAt    DateTime        @default(now())
  dischargedAt  DateTime?
  status        AdmissionStatus @default(ADMITTED)
  admittingClinicianId String?
  dischargeSummary String?
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility      Facility        @relation(fields: [facilityId], references: [id])
  bed           Bed?            @relation(fields: [bedId], references: [id])

  @@index([facilityId, status])
  @@index([patientId])
}

model Prescription {
  id            String   @id @default(cuid())
  patientId     String
  encounterId   String?
  prescribedBy  String?
  medicationName String
  dosage        String?
  frequency     String?
  duration      String?
  instructions  String?
  status        String   @default("ACTIVE")
  dispensedAt   DateTime?
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([patientId])
}

model LaboratoryOrder {
  id           String         @id @default(cuid())
  patientId    String
  facilityId   String
  orderedById  String?
  testName     String
  category     String?
  status       LabOrderStatus @default(ORDERED)
  orderedAt    DateTime       @default(now())
  sampleCollectedAt DateTime?
  completedAt  DateTime?
  approvedAt   DateTime?
  isCritical   Boolean        @default(false)
  notes        String?
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility     Facility       @relation(fields: [facilityId], references: [id])
  orderedBy    User?          @relation("OrderedBy", fields: [orderedById], references: [id])
  results      LaboratoryResult[]

  @@index([facilityId, status])
  @@index([patientId])
}

model LaboratoryResult {
  id         String          @id @default(cuid())
  orderId    String
  metric     String
  value      String
  unit       String?
  referenceRange String?
  flag       String?
  order      LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ImagingOrder {
  id           String             @id @default(cuid())
  patientId    String
  facilityId   String
  modality     String
  bodyPart     String?
  status       ImagingOrderStatus @default(REQUESTED)
  requestedAt  DateTime           @default(now())
  reportText   String?
  imageRef     String?            // external PACS/DICOM reference; not a simulated DICOM store
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility     Facility           @relation(fields: [facilityId], references: [id])

  @@index([facilityId, status])
}

model BloodDonation {
  id            String   @id @default(cuid())
  facilityId    String?
  donorName     String
  donorPhone    String?
  bloodGroup    String
  units         Int
  donatedAt     DateTime @default(now())
  expiresAt     DateTime?
  screeningStatus String?
}

model BloodInventory {
  id           String   @id @default(cuid())
  facilityId   String
  bloodGroup   String
  unitsAvailable Int    @default(0)
  unitsReserved  Int    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, bloodGroup])
}

model PharmacyInventory {
  id           String   @id @default(cuid())
  facilityId   String
  name         String
  genericName  String?
  batchNumber  String?
  expiryDate   DateTime?
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  unitPrice    Decimal? @db.Decimal(12, 2)
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  category  String?
  createdAt DateTime @default(now())
}

model InsuranceProvider {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String?
  adapterKey  String?  // configured integration adapter; never assume live
  isActive    Boolean  @default(true)
  claims      InsuranceClaim[]
}

model InsuranceClaim {
  id           String       @id @default(cuid())
  invoiceId    String?
  patientId    String?
  providerId   String
  claimNumber  String       @unique
  amount       Decimal      @db.Decimal(12, 2)
  status       ClaimStatus  @default(DRAFT)
  submittedAt  DateTime?
  responseRef  String?
  provider     InsuranceProvider @relation(fields: [providerId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([providerId, status])
}

model Invoice {
  id          String   @id @default(cuid())
  patientId   String
  facilityId  String
  invoiceNumber String @unique
  totalAmount Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @db.Decimal(12, 2) @default(0)
  status      String   @default("PENDING")
  issuedAt    DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility    Facility @relation(fields: [facilityId], references: [id])
  payments    Payment[]

  @@index([facilityId, status])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("RWF")
  method        String
  providerRef   String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  verifiedAt    DateTime?
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model Ambulance {
  id            String   @id @default(cuid())
  facilityId    String
  vehicleNumber String
  type          String?
  status        String   @default("AVAILABLE")
  facility      Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  emergencyCases EmergencyCase[]

  @@unique([facilityId, vehicleNumber])
}

model EmergencyCase {
  id            String   @id @default(cuid())
  facilityId    String?
  ambulanceId   String?
  patientName   String?
  triageLevel   Int?
  chiefComplaint String?
  status        String   @default("REGISTERED")
  createdAt     DateTime @default(now())
  ambulance     Ambulance? @relation(fields: [ambulanceId], references: [id])

  @@index([triageLevel, status])
}

model Referral {
  id                   String         @id @default(cuid())
  patientId            String
  sourceFacilityId     String
  destinationFacilityId String
  status               ReferralStatus @default(PENDING)
  reason               String?
  clinicalSummary      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceFacility       Facility       @relation("ReferralSource", fields: [sourceFacilityId], references: [id])
  destinationFacility  Facility       @relation("ReferralDestination", fields: [destinationFacilityId], references: [id])

  @@index([status])
  @@index([patientId])
}

model MaternalRecord {
  id          String   @id @default(cuid())
  patientId   String
  gravida     Int?
  para        Int?
  edd         DateTime?
  riskFlags   String?
  notes       String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([patientId])
}

model ChildHealthRecord {
  id          String   @id @default(cuid())
  patientId   String
  birthWeightKg Decimal? @db.Decimal(4, 2)
  notes       String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([patientId])
}

model Vaccination {
  id          String   @id @default(cuid())
  patientId   String
  vaccine     String
  dose        String?
  scheduledAt DateTime?
  givenAt     DateTime?
  status      String   @default("SCHEDULED")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
}

model CommunityHealthVisit {
  id          String   @id @default(cuid())
  patientId   String?
  workerId    String?
  householdRef String?
  visitAt     DateTime @default(now())
  notes       String?
  referralNeeded Boolean @default(false)
  patient     Patient? @relation(fields: [patientId], references: [id])

  @@index([visitAt])
}

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  status      String              @default("PENDING")
  sentAt      DateTime?
  user        User?               @relation(fields: [userId], references: [id])
  createdAt   DateTime            @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  facilityId  String?
  action      String
  targetType  String?
  targetId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation("ActorLogs", fields: [actorUserId], references: [id])
  facility    Facility? @relation(fields: [facilityId], references: [id])

  @@index([createdAt])
  @@index([facilityId, createdAt])
  @@index([targetType, targetId])
}

model IntegrationLog {
  id          String   @id @default(cuid())
  facilityId  String?
  integration String
  status      String
  requestRef  String?
  message     String?
  createdAt   DateTime @default(now())
  facility    Facility? @relation(fields: [facilityId], references: [id])

  @@index([integration, createdAt])
}
